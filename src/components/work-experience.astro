---
import { loadQuery } from "../sanity/lib/load-query";
import PortableText from "../components/portable-text.astro";
import { formatDateRangeHelper } from "../utils/helpers";
import type { Lang } from "../i18n/ui";

interface UiStrings {
  sectionTitles: {
    workExperience: { en: string; es: string };
  };
  present: { en: string; es: string };
}

interface Props {
  lang?: Lang;
  ui: UiStrings;
}

const { lang = "en", ui } = Astro.props as Props;

interface WorkExperience {
  title: string;
  jobTitle: string;
  jobTitleEs?: string;
  startDate: string;
  endDate: string;
  current: boolean;
  hideDescription?: boolean;
  companyName: string;
  companyNameEs?: string;
  location: string;
  locationEs?: string;
  jobDescription: any[];
  jobDescriptionEs?: any[];
  chronoIndex: number;
}

const { data: workExperiences } = await loadQuery<WorkExperience[]>({
  query: `*[_type == "workExperience"] {
    title,
    jobTitle,
    jobTitleEs,
    startDate,
    endDate,
    current,
    hideDescription,
    companyName,
    companyNameEs,
    location,
    locationEs,
    jobDescription,
    jobDescriptionEs,
    chronoIndex
  }`,
});
---

<section>
  <p class="section-title text-xl lg:text-2xl font-medium mb-2 lg:mb-4">
    {ui.sectionTitles.workExperience[lang]}
  </p>

  {
    workExperiences
      ?.sort((a, b) => b.chronoIndex - a.chronoIndex)
      ?.map((experience) => {
        const { formattedStart, formattedEnd } = formatDateRangeHelper(
          {
            startDate: experience.startDate,
            endDate: experience.endDate,
            current: experience.current,
          },
          lang,
          ui.present[lang],
        );

        const jobTitle =
          lang === "es"
            ? (experience.jobTitleEs ?? experience.jobTitle)
            : experience.jobTitle;
        const jobDescription =
          lang === "es"
            ? (experience.jobDescriptionEs ?? experience.jobDescription)
            : experience.jobDescription;
        const companyName =
          lang === "es"
            ? (experience.companyNameEs ?? experience.companyName)
            : experience.companyName;
        const location =
          lang === "es"
            ? (experience.locationEs ?? experience.location)
            : experience.location;

        return (
          <article class="cv-entry mt-4 font-normal text-base">
            <p class="text-base lg:text-lg font-semibold lg:font-medium">
              {jobTitle}
            </p>
            <p class="text-base font-medium lg:font-normal lg:text-lg italic">
              {companyName}, {location} | {formattedStart} - {formattedEnd}
            </p>
            {!experience.hideDescription && (
              <div
                class="font-normal text-gray-800 text-justify leading-relaxed"
                id="block-content"
              >
                <PortableText portableText={jobDescription} />
              </div>
            )}
          </article>
        );
      })
  }
</section>
